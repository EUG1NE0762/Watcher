# ---------------------------------------------------------------------------
# Watcher server-side configuration (Supabase Edge Functions).
# Copy to supabase/functions/.env for local `supabase functions serve`, and set
# the same names in production with `supabase secrets set NAME=value`.
# NEVER put any of these in the app or commit real values.
# ---------------------------------------------------------------------------

# Provided automatically by Supabase in deployed functions; only needed for local runs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional shared secret for cron/manual calls to ingest and recompute-scores
# (send it as the x-watcher-cron-secret header). The service role key also works.
CRON_SECRET=

# Claude: Ask Watcher assistant + plain-language explanations.
# Without a key the assistant returns the deterministic, data-only summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ElevenLabs: spoken safety briefing. Without a key the app uses on-device TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Open-weight model for ingestion (incident extraction).
# LLM_PROVIDER = openai_compatible | gemini | heuristic
#  - openai_compatible: OpenRouter, Ollama, vLLM, Groq... e.g.
#      LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=google/gemma-3-27b-it
#      LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_MODEL=gemma3:12b   (local Ollama, no key)
#  - gemini: Gemma via the Gemini API (GEMINI_API_KEY, LLM_MODEL=gemma-3-27b-it)
#  - heuristic: keyword rules, no model (default when nothing is configured)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=google/gemma-3-27b-it
GEMINI_API_KEY=

# Ingestion tuning
INGEST_MAX_ITEMS=25
# nominatim (OpenStreetMap, 1 req/s) or none
GEOCODER=nominatim
# Only items newer than this are processed (feeds carry recent items only). Raise once to backfill.
INGEST_MAX_AGE_DAYS=14
