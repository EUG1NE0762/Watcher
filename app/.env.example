# Watcher app (public) configuration. Copy to app/.env.local.
# Only the Supabase project URL and its publishable/anon key go here. Both are safe
# to ship in an app because Row Level Security protects the data.
# Leave both empty to run in offline demo mode (on-device demo dataset, clearly labelled).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
