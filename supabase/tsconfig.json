{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@watcher/scoring": [
        "../packages/scoring/src/index.ts"
      ]
    },
    "erasableSyntaxOnly": true
  },
  "include": [
    "functions/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "functions/_shared/scoring/**"
  ]
}
